<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:accessibilityHeading="true"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/bill_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/bill"
            android:text="@string/bill" />

        <EditText
            android:id="@+id/bill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="numberDecimal"
            android:importantForAutofill="no"
            android:hint="@string/bill_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/tip"
            android:paddingTop="12dp"
            android:text="@string/tip" />

        <EditText
            android:id="@+id/tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="number"
            android:importantForAutofill="no"
            android:text="10" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/people"
            android:paddingTop="12dp"
            android:text="@string/people" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/minus"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="@string/minus_symbol"
                android:contentDescription="@string/fewer_people" />

            <EditText
                android:id="@+id/people"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:gravity="center"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:text="2" />

            <Button
                android:id="@+id/plus"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="@string/plus_symbol"
                android:contentDescription="@string/more_people" />
        </LinearLayout>

        <Button
            android:id="@+id/split"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/split" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textColor="#B42318"
            android:accessibilityLiveRegion="assertive" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="18sp"
            android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
